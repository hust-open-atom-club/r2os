#!/bin/sh
### BEGIN INIT INFO
# Provides:          k230-network
# Required-Start:    networking
# Required-Stop:     networking
# Default-Start:     5
# Default-Stop:      0 6
# Short-Description: Start K230 DHCP without blocking serial login.
### END INIT INFO

start_dhcp() {
    iface="$1"

    ip link show "$iface" >/dev/null 2>&1 || return 0
    ip link set "$iface" up >/dev/null 2>&1 || true

    if command -v udhcpc >/dev/null 2>&1; then
        pid="/run/udhcpc.${iface}.pid"
        if [ -s "$pid" ] && kill -0 "$(cat "$pid")" 2>/dev/null; then
            return 0
        fi
        udhcpc -R -b -p "$pid" -i "$iface" \
            -s /usr/share/udhcpc/default.script >/dev/null 2>&1 &
    elif command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd -b "$iface" >/dev/null 2>&1 || true
    fi
}

case "$1" in
    start)
        start_dhcp eth0
        ;;
    stop)
        if [ -s /run/udhcpc.eth0.pid ]; then
            kill "$(cat /run/udhcpc.eth0.pid)" 2>/dev/null || true
            rm -f /run/udhcpc.eth0.pid
        fi
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload}"
        exit 1
        ;;
esac

exit 0
