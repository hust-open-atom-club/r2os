#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

setup_only=0
image_target="r2os-image"
deploy_dir="build-artifacts/k230-canmv"

usage() {
    cat <<EOF
Usage: $0 [--setup-only] [--image TARGET] [--deploy DIR]

Run a Yocto build directly on the host without Docker.

Environment:
  YOCTO_POKY       Poky checkout, default: ~/yocto/poky
  YOCTO_BUILD_DIR  Host build directory, default: build-artifacts/host-k230
  YOCTO_META_RISCV Optional meta-riscv checkout, default: ~/yocto/meta-riscv
  YOCTO_DOWNLOADS  Download cache; auto-detected when unset.
  YOCTO_SSTATE     Sstate cache; auto-detected when unset.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --setup-only)
            setup_only=1
            shift
            ;;
        --image)
            image_target="$2"
            shift 2
            ;;
        --deploy)
            deploy_dir="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

case "$deploy_dir" in
    ""|.|./|./.|/*|..|../*|*/..|*/../*)
        printf 'Deploy directory must be a relative path in the checkout: %s\n' "$deploy_dir" >&2
        exit 2
        ;;
esac

poky_dir="${YOCTO_POKY:-$HOME/yocto/poky}"
build_dir="${YOCTO_BUILD_DIR:-$repo_root/build-artifacts/host-k230}"
meta_riscv="${YOCTO_META_RISCV:-$HOME/yocto/meta-riscv}"
downloads="${YOCTO_DOWNLOADS:-}"
sstate="${YOCTO_SSTATE:-}"
bb_threads="${YOCTO_BB_THREADS:-12}"
make_jobs="${YOCTO_PARALLEL_MAKE_JOBS:-12}"
skip_opensbi_patch="${YOCTO_HOST_SKIP_OPENSBI_PATCH:-auto}"

if [ ! -f "$poky_dir/oe-init-build-env" ]; then
    cat >&2 <<EOF
Cannot find Poky at $poky_dir.

Set YOCTO_POKY to a Poky checkout or start Docker for the container path.
EOF
    exit 2
fi

case "$build_dir" in
    /*) ;;
    *) build_dir="$repo_root/$build_dir" ;;
esac
mkdir -p "$build_dir"
build_dir="$(cd "$build_dir" && pwd)"

if [ -z "$downloads" ]; then
    if [ -d "$HOME/yocto/meta-k230-v2/downloads" ]; then
        downloads="$HOME/yocto/meta-k230-v2/downloads"
    else
        downloads="$build_dir/downloads"
    fi
fi

if [ -z "$sstate" ]; then
    if [ -d "$HOME/yocto/meta-k230-v2/sstate-cache" ]; then
        sstate="$HOME/yocto/meta-k230-v2/sstate-cache"
    else
        sstate="$build_dir/sstate-cache"
    fi
fi

append_local_conf() {
    if ! grep -q "# Added by scripts/yocto-host-build." conf/local.conf 2>/dev/null; then
        cat >> conf/local.conf <<EOF

# Added by scripts/yocto-host-build.
MACHINE = "k230-canmv"
DISTRO = "r2os"
DL_DIR = "$downloads"
SSTATE_DIR = "$sstate"
BB_NUMBER_THREADS = "$bb_threads"
PARALLEL_MAKE = "-j $make_jobs"
EOF
    fi
}

append_opensbi_compat_conf() {
    if ! grep -q "SRC_URI:remove:pn-opensbi" conf/local.conf 2>/dev/null; then
        cat >> conf/local.conf <<'EOF'

# Host Scarthgap provides OpenSBI 1.4; the layer patch targets OpenSBI 1.8.
SRC_URI:remove:pn-opensbi = "file://0001-lib-sbi-skip-unusable-single-entry-pmp-protection.patch"
EOF
    fi
}

append_legacy_unpackdir_conf() {
    # Scarthgap has no UNPACKDIR and unpacks directly under WORKDIR.  Wrynose
    # defines it as ${WORKDIR}/sources and rejects ${WORKDIR} for every recipe,
    # so the compatibility default must not live in a layer.conf.
    if ! grep -q "# Added by scripts/yocto-host-build: legacy UNPACKDIR" conf/local.conf 2>/dev/null; then
        cat >> conf/local.conf <<'EOF'

# Added by scripts/yocto-host-build: legacy UNPACKDIR
UNPACKDIR = "${WORKDIR}"
EOF
    fi
}

set +u
source "$poky_dir/oe-init-build-env" "$build_dir" >/dev/null
set -u

mkdir -p conf
append_local_conf

poky_branch="$(git -C "$poky_dir" branch --show-current 2>/dev/null || true)"

case "$skip_opensbi_patch" in
    1|yes|true|on)
        append_opensbi_compat_conf
        append_legacy_unpackdir_conf
        ;;
    auto)
        if [ "$poky_branch" = "scarthgap" ]; then
            append_opensbi_compat_conf
            append_legacy_unpackdir_conf
        fi
        ;;
    0|no|false|off|"")
        ;;
    *)
        printf 'Invalid YOCTO_HOST_SKIP_OPENSBI_PATCH value: %s\n' "$skip_opensbi_patch" >&2
        exit 2
        ;;
esac

add_layer_if_missing() {
    local layer_path="$1"

    if [ ! -f "$layer_path/conf/layer.conf" ]; then
        return 0
    fi
    if ! bitbake-layers show-layers 2>/dev/null | awk '{print $2}' | grep -Fqx "$layer_path"; then
        bitbake-layers add-layer "$layer_path"
    fi
}

if [ -d "$meta_riscv" ]; then
    add_layer_if_missing "$meta_riscv"
fi

# R2 OS layers in dependency order.
for layer_path in \
    "$repo_root/meta-k230-bsp" \
    "$repo_root/meta-r2os-apps" \
    "$repo_root/meta-r2os-distro"; do
    add_layer_if_missing "$layer_path"
done

if [ "$setup_only" -eq 1 ]; then
    printf 'Host Yocto environment ready: %s\n' "$build_dir"
    exit 0
fi

bitbake "$image_target"

deploy_source="$build_dir/tmp/deploy/images/k230-canmv"
if [ ! -d "$deploy_source" ]; then
    printf 'Cannot find deploy directory: %s\n' "$deploy_source" >&2
    exit 2
fi

deploy_target="$repo_root/$deploy_dir"
mkdir -p "$deploy_target"

# Same handling as scripts/yocto-export-deploy: the SDK image, its work
# directory, the unpacked SD image cache and the SDK OpenSBI payload only exist
# next to the deploy mirror, so the mirroring --delete must not remove them.
# They are kept only while the SDK image provably comes from the current
# inputs, which k230-sdk-image records in "<image>.inputs"; a missing record
# means unknown provenance and is rebuilt.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f1
    else
        shasum -a 256 "$1" | cut -d ' ' -f1
    fi
}

sdk_script="$repo_root/scripts/k230-sdk-image"
default_rtt="$repo_root/prebuilt/k230-sdk/riscv-nomtee/rtt_system.bin"
stale_reason=""

for sdk_image in "$deploy_target"/*.sdk-sdcard.img; do
    [ -f "$sdk_image" ] || continue
    manifest="$sdk_image.inputs"
    image_reason=""

    if [ ! -f "$manifest" ]; then
        image_reason="no .inputs record"
    else
        while read -r key want name; do
            case "$key" in
                kernel|dtb|rootfs)
                    # BitBake inputs must be compared against the new deploy
                    # output, never against a copy left in the export directory.
                    source_file="$deploy_source/$name"
                    ;;
                fw_payload)
                    # The K230-tuned payload is only written next to the export.
                    source_file="$deploy_source/$name"
                    if [ ! -f "$source_file" ]; then
                        source_file="$deploy_target/$name"
                    fi
                    ;;
                script)
                    source_file="$sdk_script"
                    ;;
                rtt_source)
                    if [ "$want" != "default" ]; then
                        image_reason="built with a non-default RTT firmware ($want)"
                    fi
                    continue
                    ;;
                rtt)
                    source_file="$default_rtt"
                    ;;
            esac
            if [ ! -f "$source_file" ]; then
                image_reason="$key ($name) is missing"
            elif [ "$(sha256_of "$source_file")" != "$want" ]; then
                image_reason="$key ($name) changed"
            fi
            [ -z "$image_reason" ] || break
        done < "$manifest"
    fi

    if [ -n "$image_reason" ]; then
        stale_reason="$(basename "$sdk_image"): $image_reason"
        break
    fi
done

if [ -n "$stale_reason" ]; then
    rm -rf "$deploy_target"/*.sdk-sdcard.img \
        "$deploy_target"/*.sdk-sdcard.img.inputs \
        "$deploy_target"/k230-sdk-image-work \
        "$deploy_target"/fw_payload-sdk-opensbi.bin
    printf 'Invalidated the derived SDK artifacts: %s\n' "$stale_reason" >&2
fi

rsync -a --delete \
    --exclude '*.sdk-sdcard.img' \
    --exclude '*.sdk-sdcard.img.inputs' \
    --exclude 'k230-sdk-image-work/' \
    --exclude 'fw_payload-sdk-opensbi.bin' \
    "$deploy_source/." "$deploy_target/"
printf 'Exported deploy artifacts to %s\n' "$deploy_dir"
