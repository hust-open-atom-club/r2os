#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
dest="build-artifacts/k230-canmv"
dest_set=0
delete_mode="auto"

usage() {
    cat <<EOF
Usage: $0 [--clean|--keep-existing] [DEST]

Export tmp/deploy/images/k230-canmv to DEST.

Defaults:
  DEST             build-artifacts/k230-canmv
  --clean          Remove files in DEST that are absent from current deploy.
  --keep-existing  Keep files in DEST that are absent from the current deploy.

Without --clean or --keep-existing, exports under build-artifacts/ are cleaned
and other destinations keep existing files.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --clean)
            delete_mode="clean"
            shift
            ;;
        --keep-existing)
            delete_mode="keep"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            usage >&2
            exit 2
            ;;
        *)
            if [ "$dest_set" -eq 1 ]; then
                usage >&2
                exit 2
            fi
            dest="$1"
            dest_set=1
            shift
            ;;
    esac
done

case "$dest" in
    ""|.|./|./.|/*|..|../*|*/..|*/../*)
        printf "Destination must be a non-root relative path inside the R² OS checkout: %s\n" "$dest" >&2
        exit 2
        ;;
esac

delete_extra=0
case "$delete_mode:$dest" in
    clean:*|auto:build-artifacts/*)
        delete_extra=1
        ;;
esac

"$script_dir/yocto-shell" bash -lc '
set -euo pipefail

dest="$1"
delete_extra="$2"
deploy="$(find /work/build -path "*/tmp/deploy/images/k230-canmv" -type d 2>/dev/null | sort | tail -n 1)"
if [ -z "$deploy" ] || [ ! -d "$deploy" ]; then
    cat >&2 <<EOF
Cannot find tmp/deploy/images/k230-canmv.

Build first:
  ./scripts/yocto-bitbake r2os-image
EOF
    exit 2
fi

mkdir -p "/work/src/$dest"

# The SDK image, its work directory and the unpacked SD image cache used by
# k230-qemu-run only exist in the export directory, so a mirroring rsync must
# not delete them.  Keep them only while the SDK image provably comes from the
# current inputs: k230-sdk-image writes an
# "<image>.inputs" record holding the hash of every input it used, and keeping
# an image whose inputs moved on would let the smoke tests validate a previous
# build.  A missing record counts as unknown provenance and is rebuilt too.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d " " -f1
    else
        shasum -a 256 "$1" | cut -d " " -f1
    fi
}

sdk_script="/work/src/scripts/k230-sdk-image"
default_rtt="/work/src/prebuilt/k230-sdk/riscv-nomtee/rtt_system.bin"
stale_reason=""

for sdk_image in "/work/src/$dest"/*.sdk-sdcard.img; do
    [ -f "$sdk_image" ] || continue
    manifest="$sdk_image.inputs"
    image_reason=""

    if [ ! -f "$manifest" ]; then
        image_reason="no .inputs record"
    else
        while read -r key want name; do
            case "$key" in
                kernel|dtb|rootfs)
                    # BitBake inputs must be compared against the new deploy
                    # output, never against a copy left in the export directory.
                    source_file="$deploy/$name"
                    ;;
                fw_payload)
                    # The K230-tuned payload is only written next to the export.
                    source_file="$deploy/$name"
                    if [ ! -f "$source_file" ]; then
                        source_file="/work/src/$dest/$name"
                    fi
                    ;;
                script)
                    source_file="$sdk_script"
                    ;;
                rtt_source)
                    if [ "$want" != "default" ]; then
                        image_reason="built with a non-default RTT firmware ($want)"
                    fi
                    continue
                    ;;
                rtt)
                    source_file="$default_rtt"
                    ;;
            esac
            if [ ! -f "$source_file" ]; then
                image_reason="$key ($name) is missing"
            elif [ "$(sha256_of "$source_file")" != "$want" ]; then
                image_reason="$key ($name) changed"
            fi
            [ -z "$image_reason" ] || break
        done < "$manifest"
    fi

    if [ -n "$image_reason" ]; then
        stale_reason="$(basename "$sdk_image"): $image_reason"
        break
    fi
done

if [ -n "$stale_reason" ]; then
    rm -rf "/work/src/$dest"/*.sdk-sdcard.img \
        "/work/src/$dest"/*.sdk-sdcard.img.inputs \
        "/work/src/$dest"/k230-sdk-image-work
    printf "Invalidated the derived SDK artifacts: %s\n" "$stale_reason" >&2
fi

rsync_args=(-a
    --exclude "*.sdk-sdcard.img"
    --exclude "*.sdk-sdcard.img.inputs"
    --exclude "k230-sdk-image-work/")
if [ "$delete_extra" = "1" ]; then
    rsync_args+=(--delete)
fi
rsync "${rsync_args[@]}" "$deploy/." "/work/src/$dest/"
printf "Exported deploy artifacts to %s\n" "$dest"
' yocto-export-deploy "$dest" "$delete_extra"

case "${K230_RUSTSBI_BUILD:-1}" in
    1|yes|true|on)
        "$script_dir/rustsbi-build" --deploy "$repo_root/$dest"
        ;;
    0|no|false|off)
        printf 'Skipping RustSBI build because K230_RUSTSBI_BUILD=%s\n' "${K230_RUSTSBI_BUILD}"
        ;;
    *)
        printf 'Invalid K230_RUSTSBI_BUILD value: %s\n' "${K230_RUSTSBI_BUILD}" >&2
        exit 2
        ;;
esac
