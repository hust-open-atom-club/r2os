#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

backend="${YOCTO_BACKEND:-auto}"
install_system_deps=0
poky_dir="${YOCTO_POKY:-$HOME/yocto/poky}"
poky_url="${YOCTO_POKY_URL:-https://git.yoctoproject.org/poky}"
poky_branch="${YOCTO_POKY_BRANCH:-scarthgap}"
meta_riscv_dir="${YOCTO_META_RISCV:-$HOME/yocto/meta-riscv}"
meta_riscv_url="${YOCTO_META_RISCV_URL:-https://github.com/riscv/meta-riscv.git}"
meta_riscv_branch="${YOCTO_META_RISCV_BRANCH:-scarthgap}"

usage() {
    cat <<EOF
Usage: $0 [--backend auto|host|container] [--install-system-deps]

Check and prepare the local build environment.

Environment:
  YOCTO_POKY       Poky checkout, default: ~/yocto/poky
  YOCTO_POKY_URL   Poky repository URL
  YOCTO_POKY_BRANCH
                   Poky branch, default: scarthgap
  YOCTO_META_RISCV meta-riscv checkout, default: ~/yocto/meta-riscv
  YOCTO_BUILD_DIR  Host build directory, default: build-artifacts/host-k230
  DOCKER           Docker command, default: docker
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            backend="$2"
            shift 2
            ;;
        --install-system-deps)
            install_system_deps=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

case "$backend" in
    auto|host|container) ;;
    *)
        printf 'YOCTO_BACKEND must be auto, host, or container: %s\n' "$backend" >&2
        exit 2
        ;;
esac

docker_command="${DOCKER:-docker}"
docker_available=0
if command -v "$docker_command" >/dev/null 2>&1 \
    && "$docker_command" version >/dev/null 2>&1; then
    docker_available=1
fi

if [ "$backend" = "auto" ]; then
    if [ "$docker_available" -eq 1 ]; then
        selected_backend="container"
    else
        selected_backend="host"
    fi
else
    selected_backend="$backend"
fi

common_tools=(git make python3 gcc g++ tar gzip xz zstd unzip cpio file patch perl rsync)
qemu_tools=(ninja meson pkg-config)
host_tools=(bc bzip2 chrpath diffstat gawk texi2any dtc)

missing_tools=()
check_tools() {
    local tool
    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
}

check_tools "${common_tools[@]}" "${qemu_tools[@]}"
check_tools rustup
if ! command -v rust-objcopy >/dev/null 2>&1 \
    && [ ! -x "${CARGO_HOME:-$HOME/.cargo}/bin/rust-objcopy" ]; then
    missing_tools+=("rust-objcopy (cargo-binutils)")
fi
if [ "$selected_backend" = "host" ]; then
    check_tools "${host_tools[@]}"
fi

install_arch_packages() {
    local packages=(
        base-devel git python ninja pkgconf rsync cpio diffstat chrpath
        dtc bc bzip2 gawk texinfo unzip zstd
    )
    sudo pacman -S --needed "${packages[@]}"
}

install_debian_packages() {
    local packages=(
        bc build-essential bzip2 chrpath cpio diffstat file gawk git gzip
        ninja-build pkg-config patch perl python3 rsync tar texinfo unzip xz-utils
        zstd device-tree-compiler meson
    )
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends "${packages[@]}"
}

if [ "${#missing_tools[@]}" -gt 0 ]; then
    if [ "$install_system_deps" -eq 1 ]; then
        if command -v pacman >/dev/null 2>&1; then
            install_arch_packages
        elif command -v apt-get >/dev/null 2>&1; then
            install_debian_packages
        else
            printf 'No supported system package manager found.\n' >&2
            exit 2
        fi
        missing_tools=()
        check_tools "${common_tools[@]}" "${qemu_tools[@]}"
        if [ "$selected_backend" = "host" ]; then
            check_tools "${host_tools[@]}"
        fi
    fi
fi

if [ "${#missing_tools[@]}" -gt 0 ]; then
    printf 'Missing required tools: %s\n' "${missing_tools[*]}" >&2
    if command -v pacman >/dev/null 2>&1; then
        printf 'Install them with: make env-install\n' >&2
    elif command -v apt-get >/dev/null 2>&1; then
        printf 'Install them with: make env-install\n' >&2
    fi
    exit 2
fi

clone_or_select_repo() {
    local path="$1"
    local url="$2"
    local branch="$3"

    if [ -d "$path/.git" ]; then
        if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
            git -C "$path" switch "$branch" >/dev/null
        else
            git -C "$path" fetch origin "$branch"
            git -C "$path" switch --track -c "$branch" "origin/$branch"
        fi
        return
    fi

    if [ -e "$path" ]; then
        printf 'Path exists but is not a Git checkout: %s\n' "$path" >&2
        exit 2
    fi

    mkdir -p "$(dirname "$path")"
    git clone --single-branch --branch "$branch" "$url" "$path"
}

if [ "$selected_backend" = "host" ]; then
    clone_or_select_repo "$poky_dir" "$poky_url" "$poky_branch"
    clone_or_select_repo "$meta_riscv_dir" "$meta_riscv_url" "$meta_riscv_branch"

    YOCTO_POKY="$poky_dir" \
    YOCTO_BUILD_DIR="${YOCTO_BUILD_DIR:-$repo_root/build-artifacts/host-k230}" \
    YOCTO_META_RISCV="$meta_riscv_dir" \
    YOCTO_DOWNLOADS="${YOCTO_DOWNLOADS:-}" \
    YOCTO_SSTATE="${YOCTO_SSTATE:-}" \
    "$repo_root/scripts/yocto-host-build" --setup-only
else
    if [ "$docker_available" -ne 1 ]; then
        printf 'Docker engine is not reachable. Start Docker or use YOCTO_BACKEND=host.\n' >&2
        exit 2
    fi
    printf 'Docker environment is ready: %s\n' "$docker_command"
fi

printf 'Build environment is ready: backend=%s\n' "$selected_backend"
